#!/bin/sh
# pre-push hook — validates commit messages against Gitmoji + Conventional Commits
# and scans staged diff for secrets.

REMOTE="$1"
URL="$2"

COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"

if [ -f "$COMMIT_MSG_FILE" ]; then
    SUBJECT=$(head -1 "$COMMIT_MSG_FILE")

    # Warn on non-conforming messages but don't block
    if ! echo "$SUBJECT" | grep -qP '^[^\x00-\x7F]+ [a-z]+\([a-z\-]+\): .+$'; then
        echo "WARNING: Commit message doesn't follow Gitmoji + Conventional Commits format."
        echo "  Expected: <gitmoji> <type>(<scope>): <subject>"
        echo "  Got:      $SUBJECT"
        echo "  Use 'git commit --amend' to fix, or ignore this warning."
    fi

    # Check subject length (max 72 characters, not bytes)
    LEN=$(echo "$SUBJECT" | wc -m | tr -d ' ')
    if [ "$LEN" -gt 72 ]; then
        echo "WARNING: Commit subject exceeds 72 characters (got $LEN). Consider shortening."
    fi
fi

# Secret scan on staged diff
git diff --cached --diff-filter=AM -- ':(exclude)*.test.*' ':(exclude)*.spec.*' | grep -qE \
    '(sk_live_|sk_test_|AIza[A-Za-z0-9]|-----BEGIN (RSA |EC |DSA )?PRIVATE KEY-----|SUPABASE_SERVICE_ROLE_KEY)' \
    2>/dev/null && {
    echo "ERROR: Potential secret detected in staged changes. Aborting push."
    exit 1
}

exit 0
