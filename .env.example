# Copy to .env and fill in real values. Never commit .env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Git remote URL (from `git remote get-url origin`), used by the Android
# update system to discover approved GitHub Releases. No token required.
VITE_GIT_REPO=https://github.com/your-org/your-repo.git
