# Copy to .env and fill in real values. Never commit .env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Git remote URL (from `git remote get-url origin`), used by the Android
# update system to discover approved GitHub Releases. No token required.
VITE_GIT_REPO=https://github.com/your-org/your-repo.git

# ---------------------------------------------------------------------------
# Server-only variables. NEVER prefix these with VITE_ — they must not reach
# the browser bundle. In local dev the Vite API middleware loads them into
# process.env; on Vercel set them in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dedicated master key for Bolu credential encryption (AES-256-GCM).
# 64-char hex or 32-byte base64. If unset, the vault derives a key from
# SUPABASE_SERVICE_ROLE_KEY (legacy fallback). Set a dedicated key in
# production; rotating it makes existing ciphertext unreadable.
BOLU_ENCRYPTION_KEY=
# Optional env-level Bolu provider fallback (used only when no active
# connection is configured in Settings).
BOLU_PROVIDER_API_KEY=
BOLU_PROVIDER_NAME=
BOLU_PROVIDER_BASE_URL=
BOLU_PROVIDER_MODEL=
# Explicit deterministic mock mode for development/testing only.
BOLU_PROVIDER_MODE=
